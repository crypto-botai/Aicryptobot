# =============================================================
# AICryptoBot Environment Configuration
# Copy to .env and fill in your values — NEVER commit .env
# =============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3001
FRONTEND_URL=http://localhost:3000
API_SECRET=CHANGE_ME_STRONG_SECRET_32_CHARS_MIN

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://aicryptobot:password@postgres:5432/aicryptobot
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=aicryptobot
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_NAME=aicryptobot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ───────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
ENCRYPTION_IV=CHANGE_ME_16_BYTE_IV

# ── AI Models ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=nvapi-...

# ── AI Engine ────────────────────────────────────────────────
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_API_KEY=CHANGE_ME_INTERNAL_SECRET

# ── Exchange APIs (example — add per user via vault) ─────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG....
SMTP_FROM=noreply@aicryptobot.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── Licensing ────────────────────────────────────────────────
LICENSE_MASTER_KEY=CHANGE_ME_LICENSE_MASTER_KEY
LICENSE_ENCRYPTION_SECRET=CHANGE_ME_LICENSE_ENC

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
DATADOG_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
